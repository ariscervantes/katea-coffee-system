  "components": {
    "schemas": {
      "Credenciales": {
        "properties": {
          "usuario": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Usuario"
          },
          "clave": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Clave"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "usuario",
          "clave"
        ],
        "title": "Credenciales"
      },
      "DetalleError": {
        "properties": {
          "campo": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Campo"
