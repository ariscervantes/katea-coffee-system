            "description": "Precio de compra; texto decimal exacto con dos decimales"
          }
        },
        "type": "object",
        "required": [
          "producto_id",
          "cantidad",
          "precio_unitario"
        ],
        "title": "DetallePedido"
      },
      "Pedido": {
        "properties": {
          "id": {
            "type": "integer",
            "maximum": 4294967295.0,
            "exclusiveMinimum": 0.0,
            "title": "Id"
          },
          "usuario_id": {
            "type": "integer",
            "maximum": 4294967295.0,
            "exclusiveMinimum": 0.0,
            "title": "Usuario Id",
            "description": "Dueño obtenido del token, no del cuerpo"
          },
          "estado": {
            "type": "string",
            "const": "pendiente",
            "title": "Estado"
          },
          "total": {
            "type": "string",
            "title": "Total",
            "description": "Suma exacta de cantidad por precio unitario; texto con dos decimales"
          },
          "productos": {
            "items": {
              "$ref": "#/components/schemas/DetallePedido"
            },
            "type": "array",
            "title": "Productos"
          }
        },
        "type": "object",
        "required": [
          "id",
          "usuario_id",
          "estado",
          "total",
          "productos"
        ],
        "title": "Pedido"
      },
      "PedidoEntrada": {
        "properties": {
          "productos": {
            "items": {
              "$ref": "#/components/schemas/ProductoPedidoEntrada"
            },
            "type": "array",
            "minItems": 1,
            "title": "Productos"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "productos"
        ],
        "title": "PedidoEntrada"
      },
      "Producto": {
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Nombre"
          },
          "descripcion": {
            "type": "string",
            "maxLength": 200,
            "minLength": 5,
            "title": "Descripcion"
          },
          "precio": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "title": "Precio"
          },
          "imagen_url": {
            "type": "string",
            "minLength": 1,
            "title": "Imagen Url"
          },
          "disponible": {
            "type": "boolean",
            "title": "Disponible"
          },
          "preparacion": {
            "type": "string",
            "enum": [
              "frio",
              "caliente",
              "no_aplica"
            ],
            "title": "Preparacion"
          },
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nombre",
