            "exclusiveMinimum": 0.0,
            "title": "Producto Id"
          },
          "cantidad": {
            "type": "integer",
            "maximum": 4294967295.0,
            "exclusiveMinimum": 0.0,
            "title": "Cantidad"
          },
          "precio_unitario": {
            "type": "string",
