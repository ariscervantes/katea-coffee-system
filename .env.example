# Plantilla: copiar como .env y completar localmente. No contiene credenciales reales.
# Las variables exportadas en la terminal tienen prioridad sobre este archivo.

# --- MySQL (app/db/conexion.py y compose.yaml) ---
# Host donde escucha MySQL.
DB_HOST=127.0.0.1
# Puerto publicado por el contenedor de MySQL en compose.yaml.
DB_PORT=13306
# Usuario de la aplicación (sin privilegios de administrador).
DB_USER=katea_app
# Clave del usuario de la aplicación.
DB_PASSWORD=REEMPLAZAR_CON_CLAVE_PROPIA
# Nombre de la base de datos.
DB_NAME=katea
# Clave de root de MySQL; solo la usa compose.yaml al crear el contenedor.
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_OTRA_CLAVE_PROPIA

# --- Seguridad (app/seguridad.py, app/main.py y scripts/) ---
# Secreto para firmar los JWT: aleatorio, de al menos 32 bytes; se rechaza este marcador.
JWT_SECRETO=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
# Orígenes del front permitidos por CORS, separados por comas (nunca "*").
CORS_ORIGENES=http://127.0.0.1:5500,http://localhost:5500
# Debe valer "desarrollo" para habilitar scripts/crear_usuarios_desarrollo.py.
KATEA_ENTORNO=desarrollo

# --- IA externa (app/integraciones/gemini.py, POST /pedidos/comentario) ---
# Clave de Google AI Studio; sin ella la ruta responde 503.
GEMINI_API_KEY=REEMPLAZAR_CON_CLAVE_DE_GEMINI
# Modelo de Gemini que se consulta.
GEMINI_MODELO=gemini-flash-lite-latest
# URL base del servicio de IA; para las pruebas del profesor se usa http://127.0.0.1:9000 (simulador).
EXTERNO_URL=https://generativelanguage.googleapis.com
# Segundos máximos de espera por intento (si se agota, 504); un valor inválido usa 5.
EXTERNO_TIMEOUT=5

# --- Simulador del profesor (pruebas/profesor/simulador.py), opcionales ---
# Puerto donde escucha el simulador; por omisión 9000.
# SIMULADOR_PUERTO=9000
# URL de una API real a la que el simulador reenvía; vacío = respuestas simuladas.
# SIMULADOR_REAL=
