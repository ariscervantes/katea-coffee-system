# Plantilla: completar localmente antes del primer arranque. No contiene credenciales reales.
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=katea_app
DB_PASSWORD=REEMPLAZAR_CON_CLAVE_PROPIA
DB_NAME=katea
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_OTRA_CLAVE_PROPIA

# Generar localmente un secreto aleatorio; no versionar el valor real.
JWT_SECRETO=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
# Solo habilita el comando manual de cuentas de prueba.
KATEA_ENTORNO=desarrollo

# Clave de Google AI Studio para POST /pedidos/comentario. No versionar el valor real. (Usa estas variables si NO las tienes como variables de entorno en tu usario)
GEMINI_API_KEY=REEMPLAZAR_CON_CLAVE_DE_GEMINI
GEMINI_MODELO=gemini-flash-lite-latest
